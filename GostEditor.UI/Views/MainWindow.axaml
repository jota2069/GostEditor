<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GostEditor.UI.ViewModels"
        xmlns:models="using:GostEditor.Core.Models"
        xmlns:views="using:GostEditor.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="GostEditor.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        MinWidth="1100" MinHeight="700"
        Background="#F0F2F5"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush">#1565C0</SolidColorBrush>
        <SolidColorBrush x:Key="AccentHoverBrush">#0D47A1</SolidColorBrush>
        <SolidColorBrush x:Key="ToolbarBg">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="ToolbarBorder">#C8D0DA</SolidColorBrush>
        <SolidColorBrush x:Key="SurfaceBrush">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="BackgroundBrush">#F0F2F5</SolidColorBrush>
        <SolidColorBrush x:Key="BorderBrush">#D1D5DB</SolidColorBrush>
        <SolidColorBrush x:Key="TextMainBrush">#1A1A2E</SolidColorBrush>
        <SolidColorBrush x:Key="TextMutedBrush">#6B7280</SolidColorBrush>
        <SolidColorBrush x:Key="DividerBrush">#C8D0DA</SolidColorBrush>
    </Window.Resources>

    <Window.Styles>

        <Style Selector="Button.iconBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource ToolbarBorder}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.iconBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E8EEF7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.iconBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#D0DCEA"/>
        </Style>

        <Style Selector="Button.iconBtnBlue">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.iconBtnBlue:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0D47A1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="ToggleButton.iconBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource ToolbarBorder}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.iconBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E8EEF7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.iconBtn:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="ToggleButton.alignBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource ToolbarBorder}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton.alignBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E8EEF7"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ToggleButton.alignBtn:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.accentBtn">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.accentBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.toolbarBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.toolbarBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#E8EEF7"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6"/>
        </Style>

        <Style Selector="TextBox.titleInput">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.titleInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="TabControl.mainTabs > TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Padding" Value="24,12"/>
        </Style>
        <Style Selector="TabControl.mainTabs > TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="TabControl.mainTabs > TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Height" Value="3"/>
        </Style>

        <Style Selector="TabControl.hiddenTabs > TabItem">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="ListBox.sidebarMenu ListBoxItem">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.sidebarMenu ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#E8EEF7"/>
        </Style>
        <Style Selector="ListBox.sidebarMenu ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6"/>
        </Style>

    </Window.Styles>

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource ToolbarBg}"
                BorderBrush="{StaticResource ToolbarBorder}"
                BorderThickness="0,0,0,1"
                Padding="8,8"
                BoxShadow="0 2 8 0 #12000000">

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <Button Classes="iconBtn" Click="OnSaveClick"
                            IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Сохранить (Ctrl+S)">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"
                                       RadiusX="2" RadiusY="2" Stroke="#1565C0" StrokeThickness="2" Fill="Transparent"/>
                            <Rectangle Canvas.Left="6" Canvas.Top="2" Width="9" Height="7" Fill="#1565C0"/>
                            <Rectangle Canvas.Left="5" Canvas.Top="13" Width="14" Height="8"
                                       RadiusX="1" RadiusY="1" Stroke="#1565C0" StrokeThickness="1.5" Fill="#E8EEF7"/>
                        </Canvas>
                    </Button>
                    <TextBlock Text="Сохранить" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <Button Classes="iconBtn" Click="OnNewDocumentClick"
                            IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Новый документ">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="3" Canvas.Top="2" Width="13" Height="18"
                                       RadiusX="1" RadiusY="1" Stroke="#1565C0" StrokeThickness="2" Fill="Transparent"/>
                            <Line StartPoint="16,2" EndPoint="21,7" Stroke="#1565C0" StrokeThickness="1.5"/>
                            <Line StartPoint="16,2" EndPoint="16,7" Stroke="#1565C0" StrokeThickness="1.5"/>
                            <Line StartPoint="16,7" EndPoint="21,7" Stroke="#1565C0" StrokeThickness="1.5"/>
                            <Line StartPoint="17,14" EndPoint="17,22" Stroke="#1565C0" StrokeThickness="2"/>
                            <Line StartPoint="13,18" EndPoint="21,18" Stroke="#1565C0" StrokeThickness="2"/>
                        </Canvas>
                    </Button>
                    <TextBlock Text="Новый" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <Button Classes="iconBtn" Click="OnOpenClick" IsEnabled="{Binding !IsBusy}" ToolTip.Tip="Открыть файл">
                        <TextBlock Text="🗁" FontSize="22" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="Открыть" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <Button Classes="iconBtn" ToolTip.Tip="Поиск (Ctrl+F)" Click="OnSearchClick">
                        <Canvas Width="24" Height="24">
                            <Ellipse Canvas.Left="3" Canvas.Top="3" Width="13" Height="13" Stroke="#1565C0" StrokeThickness="2" Fill="Transparent"/>
                            <Line StartPoint="14,14" EndPoint="21,21" Stroke="#1565C0" StrokeThickness="2.5" StrokeLineCap="Round"/>
                        </Canvas>
                    </Button>
                    <TextBlock Text="Поиск" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <Button Classes="iconBtn" Click="OnUndoToolbarClick" ToolTip.Tip="Отменить (Ctrl+Z)">
                        <TextBlock Text="⬅" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1565C0"/>
                    </Button>
                    <TextBlock Text="CTRL+Z" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <Button Classes="iconBtn" Click="OnRedoToolbarClick" ToolTip.Tip="Повторить (Ctrl+Y)">
                        <TextBlock Text="➡" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1565C0"/>
                    </Button>
                    <TextBlock Text="CTRL+Y" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <Rectangle Width="1" Height="60" Fill="{StaticResource DividerBrush}" Margin="6,0"/>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <Button Classes="iconBtnBlue" ToolTip.Tip="Вставить текстовый блок" Click="OnInsertTextBlockClick">
                        <TextBlock Text="T" FontSize="28" FontWeight="Black" Foreground="White" FontFamily="Times New Roman" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="Текст" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <Button Classes="iconBtnBlue" ToolTip.Tip="Вставить рисунок" Click="OnInsertImageClick">
                        <Canvas Width="28" Height="24">
                            <Polygon Points="0,24 9,10 18,20 22,13 28,24" Fill="White" Opacity="0.85"/>
                            <Ellipse Canvas.Left="19" Canvas.Top="2" Width="8" Height="8" Fill="White"/>
                        </Canvas>
                    </Button>
                    <TextBlock Text="Рисунок" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <Button Classes="iconBtn" ToolTip.Tip="Вставить таблицу" Click="OnInsertTableClick">
                        <Canvas Width="24" Height="22">
                            <Rectangle Width="24" Height="22" Stroke="#1565C0" StrokeThickness="1.5" Fill="Transparent" RadiusX="2" RadiusY="2"/>
                            <Line StartPoint="0,8" EndPoint="24,8" Stroke="#1565C0" StrokeThickness="1.2"/>
                            <Line StartPoint="0,15" EndPoint="24,15" Stroke="#1565C0" StrokeThickness="1.2"/>
                            <Line StartPoint="8,0" EndPoint="8,22" Stroke="#1565C0" StrokeThickness="1.2"/>
                            <Line StartPoint="16,0" EndPoint="16,22" Stroke="#1565C0" StrokeThickness="1.2"/>
                        </Canvas>
                    </Button>
                    <TextBlock Text="Таблица" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <Rectangle Width="1" Height="60" Fill="{StaticResource DividerBrush}" Margin="6,0"/>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnBold" Classes="iconBtn" Focusable="False" Click="OnBoldClick" ToolTip.Tip="Жирный (Ctrl+B)">
                        <TextBlock Text="Ж" FontSize="24" FontWeight="Black" FontFamily="Times New Roman" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>
                    <TextBlock Text="Жирный" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnItalic" Classes="iconBtn" Focusable="False" Click="OnItalicClick" ToolTip.Tip="Курсив (Ctrl+I)">
                        <TextBlock Text="К" FontSize="24" FontStyle="Italic" FontFamily="Times New Roman" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ToggleButton>
                    <TextBlock Text="Курсив" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <Border BorderBrush="{StaticResource ToolbarBorder}" BorderThickness="1" CornerRadius="6" Background="White" Width="64" Height="52">
                        <ComboBox x:Name="FontSizeComboBox" Width="62" VerticalAlignment="Center" SelectionChanged="OnFontSizeSelectionChanged" SelectedIndex="2" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" FontSize="20" FontWeight="SemiBold" FontFamily="Times New Roman">
                            <ComboBoxItem Content="10"/><ComboBoxItem Content="12"/><ComboBoxItem Content="14"/><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="20"/><ComboBoxItem Content="24"/>
                        </ComboBox>
                    </Border>
                    <TextBlock Text="Размер" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <Rectangle Width="1" Height="60" Fill="{StaticResource DividerBrush}" Margin="6,0"/>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="Выравнивание" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <StackPanel Spacing="3">
                            <ToggleButton x:Name="BtnAlignLeft" Classes="alignBtn" Focusable="False" Click="OnAlignLeftClick" ToolTip.Tip="По левому краю">
                                <Canvas Width="26" Height="20">
                                    <Rectangle Canvas.Left="0" Canvas.Top="0" Width="26" Height="3" Fill="#1565C0"/>
                                    <Rectangle Canvas.Left="0" Canvas.Top="6" Width="18" Height="3" Fill="#1565C0"/>
                                    <Rectangle Canvas.Left="0" Canvas.Top="12" Width="22" Height="3" Fill="#1565C0"/>
                                    <Rectangle Canvas.Left="0" Canvas.Top="18" Width="14" Height="2" Fill="#1565C0"/>
                                </Canvas>
                            </ToggleButton>
                            <TextBlock Text="Слева" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <ToggleButton x:Name="BtnAlignCenter" Classes="alignBtn" Focusable="False" Click="OnAlignCenterClick" ToolTip.Tip="По центру">
                                <Canvas Width="26" Height="20">
                                    <Rectangle Canvas.Left="0" Canvas.Top="0" Width="26" Height="3" Fill="#1565C0"/>
                                    <Rectangle Canvas.Left="4" Canvas.Top="6" Width="18" Height="3" Fill="#1565C0"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="12" Width="22" Height="3" Fill="#1565C0"/>
                                    <Rectangle Canvas.Left="6" Canvas.Top="18" Width="14" Height="2" Fill="#1565C0"/>
                                </Canvas>
                            </ToggleButton>
                            <TextBlock Text="По центру" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <ToggleButton x:Name="BtnAlignRight" Classes="alignBtn" Focusable="False" Click="OnAlignRightClick" ToolTip.Tip="По правому краю">
                                <Canvas Width="26" Height="20">
                                    <Rectangle Canvas.Left="0" Canvas.Top="0" Width="26" Height="3" Fill="#1565C0"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="6" Width="18" Height="3" Fill="#1565C0"/>
                                    <Rectangle Canvas.Left="4" Canvas.Top="12" Width="22" Height="3" Fill="#1565C0"/>
                                    <Rectangle Canvas.Left="12" Canvas.Top="18" Width="14" Height="2" Fill="#1565C0"/>
                                </Canvas>
                            </ToggleButton>
                            <TextBlock Text="Справа" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <ToggleButton x:Name="BtnAlignJustify" Classes="alignBtn" Focusable="False" Click="OnAlignJustifyClick" ToolTip.Tip="По ширине">
                                <Canvas Width="26" Height="20">
                                    <Rectangle Canvas.Left="0" Canvas.Top="0" Width="26" Height="3" Fill="#1565C0"/>
                                    <Rectangle Canvas.Left="0" Canvas.Top="6" Width="26" Height="3" Fill="#1565C0"/>
                                    <Rectangle Canvas.Left="0" Canvas.Top="12" Width="26" Height="3" Fill="#1565C0"/>
                                    <Rectangle Canvas.Left="0" Canvas.Top="18" Width="26" Height="2" Fill="#1565C0"/>
                                </Canvas>
                            </ToggleButton>
                            <TextBlock Text="По ширине" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Rectangle Width="1" Height="60" Fill="{StaticResource DividerBrush}" Margin="6,0"/>

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Вставить текст" Classes="toolbarBtn" Command="{Binding PasteNormalizedCommand}" IsEnabled="{Binding !IsBusy}" FontSize="12"/>
                    <Button Content="Экспорт DOCX" Classes="accentBtn" Click="OnExportClick" IsEnabled="{Binding !IsBusy}"/>
                    <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Width="70" Height="4" VerticalAlignment="Center" Foreground="#1565C0"/>
                </StackPanel>

            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Button Content="Убрать форматирование" Classes="toolbarBtn" Padding="8,4" FontSize="11" Click="OnClearFormattingClick"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Начать с листа №:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        <NumericUpDown Minimum="1" Maximum="999"
                                       Value="{Binding ContentStartPage}"
                                       ValueChanged="OnContentStartPageValueChanged"
                                       FormatString="0" Width="80" Height="24" FontSize="11"
                                       Padding="2,0"
                                       HorizontalContentAlignment="Center"
                                       VerticalContentAlignment="Center"/>
                        <TextBlock Text="{Binding ContentStartPage, StringFormat='(Сейчас: {0})'}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Масштаб:" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <Slider Minimum="0.5" Maximum="2.0" Value="{Binding ZoomLevel}" Width="100" VerticalAlignment="Center" TickFrequency="0.1" IsSnapToTickEnabled="True" Foreground="#1565C0"/>
                    <TextBlock Text="{Binding ZoomPercentage}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Width="38"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left" Width="240" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *, Auto">
                <Border Grid.Row="0" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="НАВИГАЦИЯ" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" LetterSpacing="1"/>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="6,6">
                    <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigationItem}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:NavigationItem">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border Grid.Column="0" Width="16" IsVisible="{Binding IsSubChapter}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource TextMainBrush}" FontSize="13" VerticalAlignment="Center" FontWeight="{Binding FontWeight}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Spacing="6">
                        <Button Content="+ Глава (с нов. стр.)" Classes="toolbarBtn" Command="{Binding AddChapterCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#F9FAFB" FontSize="11" FontWeight="SemiBold"/>
                        <Button Content="+ Подраздел" Classes="toolbarBtn" Command="{Binding AddSubChapterCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#F9FAFB" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Classes="mainTabs" Background="{StaticResource BackgroundBrush}" BorderThickness="0" Padding="0">

            <TabItem Header="Редактор">
                <Grid Background="{StaticResource BackgroundBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <LayoutTransformControl HorizontalAlignment="Center" Margin="40">
                            <LayoutTransformControl.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                            </LayoutTransformControl.LayoutTransform>
                            <Border Background="White" BoxShadow="0 8 24 0 #18000000" CornerRadius="2">
                                <views:DocumentEngineView x:Name="MainEditor"/>
                            </Border>
                        </LayoutTransformControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Структура документа">
                <Grid ColumnDefinitions="300, *" Background="{StaticResource BackgroundBrush}">

                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="РАЗДЕЛЫ ПРОЕКТА" Margin="24,12,0,16" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" LetterSpacing="1"/>

                            <ListBox Classes="sidebarMenu" SelectedIndex="{Binding SelectedModuleIndex}" BorderThickness="0">

                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <CheckBox IsChecked="{Binding HasTitlePage}" Focusable="False" CornerRadius="4"/>
                                        <TextBlock Text="Титульный лист" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                </ListBoxItem>

                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <CheckBox IsChecked="{Binding HasTableOfContents}" Focusable="False" CornerRadius="4"/>
                                        <TextBlock Text="Содержание" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                </ListBoxItem>

                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <CheckBox IsChecked="{Binding HasBibliography}" Focusable="False" CornerRadius="4"/>
                                        <TextBlock Text="Список литературы" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                </ListBoxItem>

                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <CheckBox IsChecked="{Binding HasAppendix}" Focusable="False" CornerRadius="4"/>
                                        <TextBlock Text="Приложения (Код)" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                </ListBoxItem>

                            </ListBox>

                            <Border Background="#E8EEF7" CornerRadius="8" Padding="16" Margin="16,24,16,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="💡 Как это работает" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                                    <TextBlock Text="Галочка слева определяет, попадет ли этот раздел в итоговый DOCX-файл. Кликните по названию раздела, чтобы настроить его."
                                               FontSize="12" Foreground="{StaticResource TextMainBrush}" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>

                    <TabControl Grid.Column="1" Classes="hiddenTabs" SelectedIndex="{Binding SelectedModuleIndex}" Padding="0" Background="Transparent">

                        <TabItem>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <Grid ColumnDefinitions="450, *">
                                    <Border Grid.Column="0" Padding="40" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                                        <StackPanel Spacing="24">
                                            <TextBlock Text="Настройки титульного листа" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>

                                            <StackPanel Spacing="16">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Учебное заведение" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBox Text="{Binding University}" Watermark="Министерство... ВУЗ" Background="#F9FAFB" CornerRadius="6" BorderThickness="1"/>
                                                </StackPanel>

                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Кафедра" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBox Text="{Binding Department}" Watermark="Название кафедры" Background="#F9FAFB" CornerRadius="6" BorderThickness="1"/>
                                                </StackPanel>

                                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4"/>

                                                <Grid ColumnDefinitions="*, *">
                                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                                        <TextBlock Text="Дисциплина" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBox Text="{Binding Discipline}" Background="#F9FAFB" CornerRadius="6" BorderThickness="1"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                                        <TextBlock Text="Тип работы" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBox Text="{Binding WorkType}" Watermark="Курсовая работа" Background="#F9FAFB" CornerRadius="6" BorderThickness="1"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Тема работы" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBox Text="{Binding WorkTitle}" Background="#F9FAFB" CornerRadius="6" BorderThickness="1" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4"/>

                                                <Grid ColumnDefinitions="*, *">
                                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                                        <TextBlock Text="Группа" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                        <TextBox Text="{Binding GroupNumber}" Background="#F9FAFB" CornerRadius="6" BorderThickness="1"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                                        <TextBlock Text="Год сдачи" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                        <NumericUpDown Value="{Binding Year}" FormatString="0" Background="#F9FAFB" CornerRadius="6" BorderThickness="1"/>
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Студент (ФИО)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBox Text="{Binding StudentName}" Background="#F9FAFB" CornerRadius="6" BorderThickness="1"/>
                                                </StackPanel>

                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="Преподаватель (ФИО)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBox Text="{Binding TeacherName}" Background="#F9FAFB" CornerRadius="6" BorderThickness="1"/>
                                                </StackPanel>

                                            </StackPanel>

                                            <Button Content="Сбросить поля" Command="{Binding ResetTitlePageCommand}" Classes="toolbarBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FEE2E2" Foreground="#DC2626" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Padding="40" Background="{StaticResource BackgroundBrush}">
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                            <Border Width="794" Height="1123" Background="White" BoxShadow="0 10 30 0 #1A000000" CornerRadius="2">
                                                <Grid Margin="113,76,57,76">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" HorizontalAlignment="Stretch" Spacing="0">
                                                        <TextBlock Text="Министерство науки и высшего образования Российской Федерации" TextAlignment="Center" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif"/>
                                                        <TextBlock Text="Федеральное государственное бюджетное образовательное учреждение" TextAlignment="Center" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif"/>
                                                        <TextBlock Text="высшего образования" TextAlignment="Center" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif"/>
                                                        <TextBox Classes="titleInput" Text="{Binding University}" TextAlignment="Center" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" FontWeight="Bold"/>
                                                        <TextBox Classes="titleInput" Text="{Binding Department}" TextAlignment="Center" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" Margin="0,15,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Spacing="0">
                                                        <TextBox Classes="titleInput" Text="{Binding WorkType}" TextAlignment="Center" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="по дисциплине «" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" VerticalAlignment="Center"/>
                                                            <TextBox Classes="titleInput" Text="{Binding Discipline}" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" VerticalAlignment="Center"/>
                                                            <TextBlock Text="»" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="на тему « " FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" VerticalAlignment="Center"/>
                                                            <TextBox Classes="titleInput" Text="{Binding WorkTitle}" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" TextWrapping="Wrap" MaxWidth="450" VerticalAlignment="Center"/>
                                                            <TextBlock Text=" »" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,0,40" Spacing="0">
                                                        <TextBlock Text="Выполнил:" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" FontWeight="Bold" TextAlignment="Left"/>
                                                        <TextBlock Text="студент группы" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" TextAlignment="Left"/>
                                                        <TextBox Classes="titleInput" Text="{Binding GroupNumber}" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" TextAlignment="Left" TextWrapping="Wrap"/>
                                                        <TextBox Classes="titleInput" Text="{Binding StudentName}" AcceptsReturn="True" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" TextAlignment="Left" TextWrapping="Wrap"/>
                                                        <TextBlock Text="Принял:" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" FontWeight="Bold" Margin="0,15,0,0" TextAlignment="Left"/>
                                                        <TextBox Classes="titleInput" Text="{Binding TeacherName}" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" TextAlignment="Left" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="0">
                                                        <TextBox Classes="titleInput" Text="{Binding City}" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" VerticalAlignment="Center" TextAlignment="Right"/>
                                                        <TextBlock Text=", " FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" VerticalAlignment="Center"/>
                                                        <TextBox Classes="titleInput" Text="{Binding Year}" FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" г." FontSize="19" FontFamily="Times New Roman, Liberation Serif, serif" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Viewbox>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem>
                            <Border Padding="60">
                                <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">
                                    <TextBlock Text="Содержание (Оглавление)" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>

                                    <TextBlock Text="Оглавление формируется автоматически при экспорте в Word. Программа находит все абзацы со стилем «Глава» (Heading 1) и «Подраздел» (Heading 2) и выстраивает из них иерархию с указанием номеров страниц."
                                               FontSize="15" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="24"/>

                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,16,0,0">
                                        <StackPanel Spacing="16">
                                            <TextBlock Text="Пример генерации:" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>

                                            <Grid ColumnDefinitions="*, Auto" Margin="0,8">
                                                <TextBlock Grid.Column="0" Text="ВВЕДЕНИЕ" FontWeight="Bold" FontFamily="Times New Roman" FontSize="16"/>
                                                <TextBlock Grid.Column="1" Text="3" FontFamily="Times New Roman" FontSize="16"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Grid.Column="0" Text="1. ТЕОРЕТИЧЕСКАЯ ЧАСТЬ" FontWeight="Bold" FontFamily="Times New Roman" FontSize="16"/>
                                                <TextBlock Grid.Column="1" Text="4" FontFamily="Times New Roman" FontSize="16"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*, Auto" Margin="24,0,0,0">
                                                <TextBlock Grid.Column="0" Text="1.1 Обзор предметной области" FontFamily="Times New Roman" FontSize="16"/>
                                                <TextBlock Grid.Column="1" Text="4" FontFamily="Times New Roman" FontSize="16"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </TabItem>

                        <TabItem>
                            <Grid ColumnDefinitions="420, *">
                                <Border Grid.Column="0" Padding="40" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                                    <StackPanel Spacing="18">
                                        <TextBlock Text="Список литературы" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>

                                        <TextBox Text="{Binding NewBibliographySource}"
                                                 Watermark="Иванов И. И. Название книги. - Москва: Издательство, 2024."
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="100"
                                                 Background="#F9FAFB"
                                                 CornerRadius="6"
                                                 BorderThickness="1"/>

                                        <Button Content="Добавить источник"
                                                Classes="accentBtn"
                                                Command="{Binding AddBibliographySourceCommand}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Padding="12,12"/>

                                        <Grid ColumnDefinitions="*, *">
                                            <Button Grid.Column="0"
                                                    Content="Удалить"
                                                    Command="{Binding RemoveBibliographySourceCommand}"
                                                    Classes="toolbarBtn"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Background="#FEE2E2"
                                                    Foreground="#DC2626"
                                                    Margin="0,0,5,0"/>
                                            <Button Grid.Column="1"
                                                    Content="Очистить"
                                                    Command="{Binding ClearBibliographySourcesCommand}"
                                                    Classes="toolbarBtn"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Background="#F9FAFB"
                                                    Margin="5,0,0,0"/>
                                        </Grid>

                                        <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                                            <TextBlock Text="При экспорте выбранные источники попадут в раздел «СПИСОК ИСПОЛЬЗОВАННЫХ ИСТОЧНИКОВ» перед приложениями."
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="19"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Padding="40" Background="{StaticResource BackgroundBrush}">
                                    <Grid RowDefinitions="Auto, *">
                                        <TextBlock Grid.Row="0" Text="Источники:" FontWeight="Bold" FontSize="18" Margin="0,0,0,20" Foreground="{StaticResource TextMainBrush}"/>

                                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <ScrollViewer>
                                                <ListBox ItemsSource="{Binding BibliographySources}"
                                                         SelectedItem="{Binding SelectedBibliographySource}"
                                                         Background="Transparent"
                                                         Padding="8">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:BibliographySourceViewModel">
                                                            <Border Background="#F9FAFB" CornerRadius="6" Padding="12,10" Margin="0,4">
                                                                <Grid ColumnDefinitions="Auto, Auto, *">
                                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayNumber}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Top" Margin="10,0"/>
                                                                    <TextBox Grid.Column="2"
                                                                             Text="{Binding Description}"
                                                                             AcceptsReturn="True"
                                                                             TextWrapping="Wrap"
                                                                             Background="Transparent"
                                                                             BorderThickness="0"
                                                                             Padding="0"
                                                                             FontSize="13"
                                                                             Foreground="{StaticResource TextMainBrush}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem>
                            <Grid ColumnDefinitions="380, *">
                                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="32">
                                    <StackPanel Spacing="20">
                                        <TextBlock Text="Приложения (Листинги)" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}"/>

                                        <TextBlock Text="Загрузите папку с вашим проектом. GostEditor автоматически прочитает файлы и добавит их в конец документа как листинги кода."
                                                   FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" LineHeight="20"/>

                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4"/>

                                        <Button Content="Выбрать папку проекта"
                                                Classes="accentBtn"
                                                Click="OnParseFolderClick"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Padding="12,14"/>
                                        <Button Content="Очистить список" Command="{Binding ClearCodeListingsCommand}" Classes="toolbarBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#FEE2E2" Foreground="#DC2626"/>

                                        <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,20,0,0">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Форматирование ГОСТ:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextMainBrush}"/>
                                                <TextBlock Text="• Раздел «ПРИЛОЖЕНИЕ А»&#x0a;• Шрифт: Consolas, 10pt&#x0a;• Одинарный интервал&#x0a;• Подпись: Листинг 1 — Имя файла"
                                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="20"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="40" Background="{StaticResource BackgroundBrush}">
                                    <Grid RowDefinitions="Auto, *, Auto">
                                        <TextBlock Grid.Row="0" Text="Выбранные файлы:" FontWeight="Bold" FontSize="18" Margin="0,0,0,20" Foreground="{StaticResource TextMainBrush}"/>

                                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <ScrollViewer>
                                                <ListBox ItemsSource="{Binding CodeListings}" Background="Transparent" Padding="8">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:CodeListingViewModel">
                                                            <Border Background="#F9FAFB" CornerRadius="6" Padding="12,10" Margin="0,4">
                                                                <Grid ColumnDefinitions="*, Auto">
                                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Content="{Binding Listing.FileName}" FontWeight="Medium" FontSize="14" Foreground="{StaticResource TextMainBrush}"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding LinesCount, StringFormat='{}Строк: {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </ScrollViewer>
                                        </Border>

                                        <Button Grid.Row="2" Content="Вставить код прямо в текст (опционально)" Classes="toolbarBtn" Command="{Binding InsertCodeToEditorCommand}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
